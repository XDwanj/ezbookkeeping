# Image published by this fork. Use a version or sha tag to pin a deployment.
EBK_IMAGE=ghcr.io/xdwanj/ezbookkeeping:latest-snapshot

# Set to 0:0 to run the container as root. No privileged mode is needed.
EBK_CONTAINER_USER=1000:1000
EBK_BIND_ADDRESS=0.0.0.0
EBK_PORT=8080
TZ=Asia/Shanghai

# Set to the URL users actually visit, including the port and trailing slash.
EBK_SERVER_ROOT_URL=http://localhost:8080/

# Generate with: openssl rand -hex 32
# Keep this value unchanged across upgrades.
EBK_SECURITY_SECRET_KEY=
